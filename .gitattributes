# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Force LF for shell, yaml, config, and node scripts
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
.htaccess text eol=lf
.cpanel.yml text eol=lf
