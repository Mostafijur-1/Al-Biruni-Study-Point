{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["bom1"],
  "env": {
    "ROUTINE_PUBLISHING_ENABLED": "true",
    "ATTENDANCE_WRITES_ENABLED": "true"
  },
  "crons": [
    {
      "path": "/api/cron/evening-reminder",
      "schedule": "0 14 * * *"
    }
  ]
}
