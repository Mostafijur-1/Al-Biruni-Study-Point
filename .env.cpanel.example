# ==============================================================================
# Production Environment Variables for cPanel (abspoint.top)
# ==============================================================================
# In cPanel:
# Go to "Setup Node.js App" -> Click Edit on your application -> Scroll down to "Environment variables"
# Add each key and value below.
# Alternatively, you can save this file as .env or .env.production in the application root directory.

# Server & Node Environment
NODE_ENV=production
PORT=3000

# Site URL
NEXT_PUBLIC_APP_URL=https://abspoint.top
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# Database (MongoDB Atlas)
# Note: In MongoDB Atlas Network Access, ensure IP 0.0.0.0/0 (or your Procloudify server IP) is allowed.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/absp?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000

# JWT Authentication Secrets (Generate 32+ random characters each)
JWT_ACCESS_SECRET=generate_strong_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=generate_different_strong_random_secret_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Google OAuth (Optional: if enabled, set authorized redirect URI to https://abspoint.top/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (Optional: for CQ uploads and image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push Notifications & Cron Tasks
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=generate_long_random_cron_secret

# AI / MCQ Parsing Keys (Groq / Gemini / OpenRouter)
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MAX_TOKENS=3800

# Application Feature Flags & Gates
ASSESSMENT_KERNEL_WRITES=false
ACADEMIC_WRITES_ENABLED=false
CANONICAL_ACADEMIC_SHADOW_READS_ENABLED=false
CANONICAL_ACADEMIC_AUTHORITY_ENABLED=false
ROUTINE_PUBLISHING_ENABLED=false
ATTENDANCE_WRITES_ENABLED=false
WRITTEN_EXAM_KERNEL_WRITES=true
FINANCE_LEDGER_AUTHORITY_ENABLED=false
REPORTING_PROJECTIONS_ENABLED=false
