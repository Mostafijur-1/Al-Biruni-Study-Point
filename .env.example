# Copy to .env.local for development. Add the same keys in Vercel → Project → Settings → Environment Variables.

# Database (MongoDB Atlas — allow 0.0.0.0/0 or Vercel IPs for serverless)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/absp

# JWT (use long random strings, min 32 characters each)
JWT_ACCESS_SECRET=replace_with_minimum_32_characters_secret
JWT_REFRESH_SECRET=replace_with_another_32_characters_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Cloudinary (optional — CQ image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# App URL (production: your Vercel domain, e.g. https://absp.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# Academic Core rollout (keep false until bootstrap + DB integration checks pass)
ACADEMIC_WRITES_ENABLED=false
# Step 3: shadow first; authority stays false until exact-commit parity evidence is reviewed.
CANONICAL_ACADEMIC_SHADOW_READS_ENABLED=false
CANONICAL_ACADEMIC_AUTHORITY_ENABLED=false
ROUTINE_PUBLISHING_ENABLED=false
ATTENDANCE_WRITES_ENABLED=false
# Dedicated disposable replica-set database only; never point these at production.
ACADEMIC_TEST_MONGODB_URI=mongodb://localhost:27017
ACADEMIC_TEST_DB_NAME=absp_academic_test

# Push notifications and protected scheduled jobs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
CRON_SECRET=replace_with_long_random_cron_secret

# LLM — Groq (primary text MCQ parsing) + Gemini (fallback)
GROQ_API_KEYS=key1,key2,key3
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter (image MCQ upload parsing — vision)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
# Required on free/low-credit accounts (OpenRouter defaults to ~65535 without this)
OPENROUTER_MAX_TOKENS=3800
